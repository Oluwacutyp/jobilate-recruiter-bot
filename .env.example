# Copy to .env and fill in YOUR values. Never commit .env.
# run.py loads .env automatically — no need to set env vars in PowerShell.
BOT_TOKEN=
ADMIN_CHAT_ID=
DATA_DIR=./data
QUIET_HOURS_START=22
QUIET_HOURS_END=07
SCRAPE_MIN_DELAY_SECONDS=3
CACHE_TTL_MINUTES=15
# Turnstile fallback (Playwright): 1 = bot clicks "Verify you're human" itself
# in its own browser when Jiji blocks requests. 0 = requests only.
PLAYWRIGHT_ENABLED=1
# 0 = headed browser (default on Windows, best Turnstile pass rate).
# 1 = headless. Leave blank for the default.
PLAYWRIGHT_HEADLESS=
# Browser profile dir (verified Turnstile session persists here).
# Leave blank for DATA_DIR/browser_profile.
BROWSER_PROFILE_DIR=
